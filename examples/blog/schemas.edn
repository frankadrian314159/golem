;; Blog API: authors, posts and comments, linked by integer foreign keys.
;; Foreign keys are limited to 1..5 so they point at real records when the
;; server runs with the default --count 5.
{:author [:map
          [:id :int]
          [:name [:string {:min 1 :max 30}]]
          [:email :string]
          [:bio {:optional true} [:string {:max 120}]]
          [:created_at :string]]

 :post [:map
        [:id :int]
        [:author_id [:int {:min 1 :max 5}]]
        [:title [:string {:min 1 :max 60}]]
        [:body :string]
        [:status [:enum "draft" "published" "archived"]]
        [:tags [:vector {:max 4} :string]]
        [:stats [:map
                 [:views [:int {:min 0 :max 10000}]]
                 [:likes [:int {:min 0 :max 500}]]]]
        [:created_at :string]
        [:updated_at :string]]

 :comment [:map
           [:id :int]
           [:post_id [:int {:min 1 :max 5}]]
           [:author_name [:string {:min 1 :max 30}]]
           [:text [:string {:min 1 :max 200}]]
           [:created_at :string]]}
